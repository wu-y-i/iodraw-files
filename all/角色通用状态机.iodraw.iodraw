        <mxCell id="ya-wU9cjDBqrNHa2w1-U-13" value="内部互转：来自时间和概率&lt;div&gt;该状态处理来自队列的EnemyInSight改变事件和释放技能事件&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="150" y="630" width="160" height="44.4" as="geometry" />
        </mxCell>
        <mxCell id="ya-wU9cjDBqrNHa2w1-U-17" value="所有互转均来自事件，EnemyInSight改变、动画播放结束也会作为事件广播&lt;div&gt;转向期间事件会首先加入事件队列，e/q期间拒绝新的技能&lt;/div&gt;&lt;div&gt;事件在空闲帧的LateUpdate从队列首取出并处理&lt;/div&gt;&lt;div&gt;空闲帧：Standby和Attacking的全部，以及InSkill的可打断帧&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px; text-wrap: nowrap; background-color: rgb(255, 255, 255);&quot;&gt;EnemyInSight = false所涉及的切换，应当在动画末尾帧进行，以便播放完成收尾动画&lt;/span&gt;&lt;br&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="990" y="110" width="450" height="130" as="geometry" />
        </mxCell>
        <mxCell id="9gHQaG3MXqAENwHzrwCr-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1.007;exitY=0.768;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitPerimeter=0;" parent="1" source="PKLYiKoXfrn9WOMwwd7i-1" target="PKLYiKoXfrn9WOMwwd7i-6" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ya-wU9cjDBqrNHa2w1-U-7" value="朝向前 &amp;amp;&amp;amp; EnemyInSight = true" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="9gHQaG3MXqAENwHzrwCr-7">
          <mxGeometry x="-0.155" y="3" relative="1" as="geometry">
            <mxPoint y="-5" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ya-wU9cjDBqrNHa2w1-U-18" value="该状态不处理任何事件&lt;div&gt;事件只会加入队列&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="460" y="630" width="160" height="44.4" as="geometry" />
        </mxCell>
        <mxCell id="PKLYiKoXfrn9WOMwwd7i-24" value="内部互转：来自用户操作。&lt;div&gt;只有该状态会处理操作模式改变以切换动画&lt;/div&gt;&lt;div&gt;其他状态不需要监听&lt;/div&gt;&lt;div&gt;该状态还处理EnemyInSight改变事件和释放技能事件&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="785" y="630" width="290" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ya-wU9cjDBqrNHa2w1-U-19" value="该状态只处理收尾动画播放" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="430" y="220" width="240" height="44.4" as="geometry" />
        </mxCell>
